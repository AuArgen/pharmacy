# Скопируйте этот файл в .env и при необходимости измените значения:
#   cp .env.example .env

# Порт, на котором открывается сайт: http://localhost:PORT
PORT=8080

# Пароль для входа в админ-панель: http://localhost:PORT/admin.php
ADMIN_PASSWORD=admin123

# 1 — отключить обратное геокодирование (offline-режим, без обращения к OSM)
DISABLE_GEOCODING=0
